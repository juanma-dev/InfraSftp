<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="InfraSftp.Views.DragVisualWindow"
        Title="DragVisualWindow"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        Opacity="0.8">
  <Border Background="{DynamicResource SurfaceTranslucent60Brush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="8,4"
          BoxShadow="0 4 12 0 #00000040">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <TextBlock x:Name="IconBlock" Text="📄" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock x:Name="TextBlock" Text="Item" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
    </StackPanel>
  </Border>
</Window>
